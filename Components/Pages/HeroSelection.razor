@page "/heroes"
@using Operation_Extraction.Models
@inject IGameStateService GameState
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Select Hero</PageTitle>

<div class="mobile-shell">
    <div class="panel">
        <div class="section-header">
            <span class="eyebrow">Operator Roster</span>
            <h2>Choose a Hero</h2>
        </div>

        <div class="hero-grid">
            @foreach (var hero in Heroes)
            {
                <div class="hero-card">
                    <div class="hero-badge" style="background:@hero.AccentColor;">@hero.Name[..1]</div>
                    <div class="hero-meta">
                        <h3>@hero.Name</h3>
                        <p>@hero.Role • @hero.Specialty</p>
                    </div>
                    <ul class="hero-stats compact-list">
                        <li>HP @hero.MaxHealth</li>
                        <li>Armor @hero.Armor</li>
                        <li>Move @hero.Movement</li>
                    </ul>
                    <button class="btn btn-primary btn-sm w-100" @onclick="() => SelectHero(hero)">Select</button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<Hero> Heroes => GameState.HeroRoster;

    protected override void OnInitialized()
    {
        GameState.InitializeHeroes();
    }

    private void SelectHero(Hero hero)
    {
        GameState.StartNewMatch(hero);
        Navigation.NavigateTo("/game");
    }
}
